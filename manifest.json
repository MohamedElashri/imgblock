{
  "manifest_version": 2,
  "name": "ImgBlock",
  "version": "1.0",
  "description": "Removes all non-icon images from the current page",
  "author": "Mohamed Elashri",
  "homepage_url": "https://github.com/MohamedElashri/imgblock",
  "developer": {
    "name": "Mohamed Elashri",
    "url": "https://melashri.net"
  },
  "icons": {
    "16": "icons/icon.svg",
    "32": "icons/icon.svg",
    "64": "icons/icon.svg",
    "128": "icons/icon.svg"    
  },
  "permissions": ["activeTab", "storage"],
  "browser_action": {
    "default_icon": "icons/icon.svg",
    "default_title": "ImgBlock",
    "default_popup": "popup.html"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "content_security_policy": "script-src 'self'; object-src 'self'"
}
